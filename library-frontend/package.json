{
  "name": "library-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "demo:overlays": "vite --open /prototypes/overlay-demo/",
    "demo:ai": "vite --config prototypes/ai-assistant-demo/vite.config.js --open /prototypes/ai-assistant-demo/reader",
    "demo:agent-loop": "vite --open /prototypes/agent-loop-demo/",
    "build": "vite build",
    "preview": "vite preview",
    "test:ci": "vitest run",
    "lint:check": "eslint src vite.config.js eslint.config.js scripts && npm run architecture:check",
    "architecture:check": "node scripts/check-module-boundaries.mjs",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.9",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "prettier": "3.6.2",
    "vite": "^7.2.4",
    "vitest": "^5.0.0"
  }
}
