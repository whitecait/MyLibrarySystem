# Local Windows-native P3 runner settings. Copy this file to .env.p3.
# Put account passwords here only; do not place model-provider credentials here.
P3_BASE_URL=http://127.0.0.1:8092
P3_LIBRARIAN_USERNAME=
P3_LIBRARIAN_PASSWORD=

# Required for the real-model role check in the AI draft suite.
P3_READER_USERNAME=
P3_READER_PASSWORD=
P3_AI_READER_ID=
P3_AI_TITLE_ID=
P3_AI_COPY_ID=

# Read-only database readback from the current isolated stack.
P3_BUSINESS_DATE=
P3_AI_COPY_LOAN_ELIGIBLE_ON=

# Keep 0 until this run is authorized to borrow the one-shot test copy.
P3_AI_EXPLICIT_SUBMIT=0

# One Chrome channel; no cross-browser matrix is run by this suite.
# Each invocation gets a unique child directory below this evidence root.
P3_OUTPUT_BASE=../artifacts/m6-acceptance/p3-blockers
