{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylibrary.local/contracts/contract-scenarios.schema.json",
  "title": "MyLibrarySystem shared contract scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "0.2"},
    "status": {"const": "APPROVED"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"enum": ["GET", "POST", "PATCH", "DELETE"]},
        "path": {"type": "string", "pattern": "^/api/v1/"},
        "headers": {"$ref": "#/$defs/headers"},
        "body": {"type": "object"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpStatus", "body"],
      "properties": {
        "httpStatus": {"type": "integer", "minimum": 100, "maximum": 599},
        "headers": {"$ref": "#/$defs/headers"},
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "data"],
          "properties": {
            "code": {"type": "string", "pattern": "^MLS-[A-Z]+-(S[0-9]{3}|[0-9]{3})$"},
            "message": {"type": "string"},
            "data": {"type": "object"}
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request", "response", "expect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
        "request": {"$ref": "#/$defs/request"},
        "response": {"$ref": "#/$defs/response"},
        "expect": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
