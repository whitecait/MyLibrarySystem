# Template for application.yml — copy to application.yml and adjust values.
# The real application.yml is intentionally NOT tracked by git (see .gitignore
# at the repo root). Keep real credentials out of version control; inject them
# via environment variables for shared or production environments.

server:
  port: 8080
  servlet:
    context-path: /api
    encoding:
      charset: UTF-8
      enabled: true

spring:
  profiles:
    active: dev

  # ---- DEV profile: H2 in-memory (no MySQL required) ----
  # Activate via: --spring.profiles.active=dev (default)
  datasource:
    url: jdbc:h2:mem:library;DB_CLOSE_DELAY=-1;MODE=MySQL
    driver-class-name: org.h2.Driver
    username: sa
    password:
  h2:
    console:
      enabled: true
      path: /h2-console

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.H2Dialect
        auto_quote_keyword: true

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

# ---- Swagger / SpringDoc ----
springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha

# ---- Library business configuration ----
library:
  borrow:
    max-limit: 5
    default-duration-days: 30
    auto-approve-duration: 30
    max-duration-cap: 60
  fine:
    rate-per-day: 1.0
  renewal:
    auto-approve-count: 1

# ---- JWT ----
jwt:
  secret: CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_256_BITS_LONG
  expiration: 86400000  # 24 hours in ms

# ---- File upload ----
file:
  upload-dir: uploads/

---
# ---- PROD profile: MySQL ----
# Activate via: --spring.profiles.active=prod
# Fill in credentials locally or via environment variables; never commit them.
spring:
  config:
    activate:
      on-profile: prod
  datasource:
    url: jdbc:mysql://localhost:3306/library?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: CHANGE_ME
    password: CHANGE_ME
  jpa:
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
    show-sql: false
