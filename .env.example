# Local development only. Copy to .env and set your own value.
DB_PASSWORD=local-development-only
# Replace with at least 32 random bytes; never reuse this example value outside local development.
AI_VISITOR_COOKIE_SIGNING_KEY=local-development-ai-cookie-key-change-me-now
FRONTEND_PORT=8088

# The backend closes the previous business date daily at midnight China time.
# A successful close stays isolated until an administrator explicitly reopens it.
LIBRARY_CLOSING_DAILY_ENABLED=true
LIBRARY_CLOSING_DAILY_CRON=0 0 0 * * *
LIBRARY_CLOSING_TIME_ZONE=Asia/Shanghai

# Unified local verification; fill the real values only in ignored .env.
# BASE_URL includes the provider's API prefix (for example /v1).
BASE_URL=https://example.invalid/v1
MODEL=
API_KEY=
# Used by compose.observability.yaml; choose a local password.
GRAFANA_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Optional provider-specific candidate; unset preserves the provider default.
# THINKING_MODE=disabled

# Optional prebuilt delivery images; unset uses the local foundation tags.
# BACKEND_IMAGE=mls-backend:<delivery-tag>
# FRONTEND_IMAGE=mls-frontend:<delivery-tag>
# Optional complete model endpoint for base Compose deployments.
# AI_ENDPOINT_URL=https://example.invalid/v1/chat/completions
# AI_MODEL=
# AI_API_KEY=
