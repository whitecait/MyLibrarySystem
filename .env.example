# Local development only. Copy to .env and set your own value.
DB_PASSWORD=local-development-only
FRONTEND_PORT=8088

# Unified local verification; fill the real values only in ignored .env.
# BASE_URL includes the provider's API prefix (for example /v1).
BASE_URL=https://example.invalid/v1
MODEL=
API_KEY=
# Used by compose.observability.yaml; choose a local password.
GRAFANA_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Optional provider-specific candidate; unset preserves the provider default.
# THINKING_MODE=disabled
