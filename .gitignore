# ============================================
# MyLibrarySystem — Unified .gitignore
# Covers: Spring Boot (Maven) + Vue 3 (Vite) + Docker
# ============================================

# --- Java / Maven ---
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# --- Node / Vue / Vite ---
node_modules/
dist/
.vite/
*.local

# --- IDE ---
.idea/
*.iml
.vs/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs ---
Logs/*.log
Logs/*.log.*

# --- Docker ---
# (keep Dockerfile and docker-compose.yml; ignore runtime data)
docker-data/

# --- Env & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
application-local.yml

# --- Misc ---
*.tmp
*.bak
.cache/
.code-graph/
