# ============================================
# MyLibrarySystem — hybrid tracking policy
#
# Root level: whitelist mode — everything at the repo root is
# ignored except the explicitly allowed entries below.
# Sub-paths: blacklist mode — library-frontend/ and library-server/
# are tracked by default except for the excluded patterns below.
#
# Tracked scope: key source code only.
# Never tracked: secrets / environment config, build artifacts,
# demo or throwaway prototypes, runtime data.
#
# docs/ remains baseline-only tracking: register the file in the
# docs/README.md maintenance baseline table, then `git add -f`.
# 90-archive/ files are NON-normative and never tracked.
# docs/agents/ and root AGENTS.md are intentionally untracked local
# agent-operating docs (user decision 2026-09-07); the exclusion is
# declared in the docs/README.md maintenance baseline.
# HANDOFF.md and TODO.md are tracked development-process docs at the
# repo root (user decision 2026-09-07); they live outside the docs/
# library and its governance.
# ============================================

# --- Root level: whitelist ---
*
/*
!.gitignore
!.gitattributes
!README.md
!HANDOFF*.md
!TODO.md
!library-frontend/
!library-server/

# --- library-frontend/ : blacklist (track by default) ---
!library-frontend/**
# Dependencies and build artifacts
library-frontend/node_modules/
library-frontend/dist/
library-frontend/.vite/
library-frontend/coverage/
# Demo / throwaway prototypes
library-frontend/prototypes/
# Environment config (only *.example templates stay trackable)
library-frontend/.env
library-frontend/.env.*
!library-frontend/.env.example
library-frontend/*.local

# --- library-server/ : blacklist (track by default) ---
!library-server/**
# Legacy implementation archive (behavior reference only;
# superseded by the full-rewrite strategy, recoverable from history)
library-server/arc/
# Build artifacts
library-server/target/
# Runtime data
library-server/uploads/
library-server/logs/
library-server/**/*.log
# Local environment overrides carrying credentials (default
# application.yml stays trackable and contains no secrets)
library-server/src/main/resources/application-*.yml

# Reproducible infrastructure; secrets and generated evidence remain ignored.
!compose.yaml
!compose.observability.yaml
!compose.integration.yaml
!observability/
!observability/**
!.env.example
!scripts/
!scripts/verify.sh
!scripts/verify-compose.sh
!scripts/k6-health.js
!scripts/verify-observability.sh
!scripts/verify-integration.sh
!scripts/check-sensitive-evidence.sh
!scripts/test-sensitive-evidence.sh
!scripts/integration/
!scripts/integration/**
!.github/
!.github/workflows/
!.github/workflows/ci.yml
library-frontend/reports/
!ENGINEERING.md
!scripts/test-database-readiness.sh
!scripts/check-review-docs.py
!scripts/audit-g34-review.py
!scripts/sanitize-idempotency-snapshots.py
!scripts/test-sanitize-idempotency-snapshots.py
# --- M6 acceptance harness (2026-09-19) ---
!compose.acceptance.yaml
!compose.perf-quota.yaml
!compose.payment-egress.yaml
!e2e/
!e2e/**
# re-ignore within e2e (whitelisted above)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/perf/out/
e2e/data/out/
# unpacked previous-major browsers (Chrome for Testing etc.), re-downloadable
e2e/browsers/installs/
!scripts/prepare-acceptance-env.sh
!scripts/collect-ai-connection-evidence.sh
!scripts/collect-evidence-secret-values.sh
!scripts/check-sensitive-evidence-deep.sh
!scripts/observation-probe.sh
!scripts/observation-report.mjs
!scripts/drill-backup-restore.sh
!scripts/payment-egress-audit.sh
!scripts/sanitize-evidence-traces.sh
!scripts/collect-env-evidence.sh
!scripts/redact-evidence-values.sh

# Reproducible release gates; original verification/ remains local-only.
!formal/
!formal/**
formal/.cache/
formal/output/
formal/**/__pycache__/
!scripts/check-migrations.py
!scripts/test-check-migrations.py
!scripts/delivery/
!scripts/delivery/**
scripts/delivery/__pycache__/

!scripts/observability-env.sh
!scripts/test-observability-env.sh
